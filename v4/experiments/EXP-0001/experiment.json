  "title": "Q1 baseline: constant per target (train median), 50 mapped-grade outputs",
  "assumptions": [
    "The 50 targets are mapped grades, not the original 0-6 scale (mapping uses TRAIN-only zmin/zmax).",
    "A constant predictor per target is the naive comparator: it uses no chemical feature.",
    "Holdout rows are scored exactly once by this baseline."
  ],
  "equations": [
    "yhat_t = median_{i in TRAIN}(y_{i,t}) for each of the 50 targets t",
    "mae = (1/50) * sum_t MAE_holdout(t)"
