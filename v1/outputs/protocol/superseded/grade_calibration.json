    ],
    "conclusion": "4.csv 只做了中心化 + 一个未知的（全局或逐列）缩放，不是逐列单位方差标准化；因此'grade 3 锚定 z=0'与'1 个 z 单位 = 1 个等级'都不能由 4.csv 单独辨识。本项目改用外部物理锚点（8.xlsx 气味阈值 ⇒ OAV=1 为恰可察觉，对应等级 1）来定 location，并用 range/quantile/sigma 三套替代标定做敏感性。"
  },
  "policies": {
    "P1_oav_anchor": "g = clip(floor((v - a_d)/s_d + 0.5), 0, 6)，(a_d, s_d) 由 v_d ~ log10(OAV_driver) 稳健回归估得；a_d 锚定 OAV=1（恰可察觉=等级 1），s_d 为每个数量级 OAV 的等级宽度",
    "P2_range": "g = clip(floor(6*(v - min_d)/(max_d - min_d) + 0.5), 0, 6)（假设 250 款样覆盖该维全量程）",
    "P3_quantile": "g = clip(7 等分位数分箱, 0, 6)（假设该维等级分布近似均匀）",
    "P4_sigma": "g = clip(floor(v/S + 3.5), 0, 6)，S=1.0（旧口径，保留以便对比）"
  },
